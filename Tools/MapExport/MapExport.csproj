<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MapExport —— .spmap → OpenDRIVE / OSM / Shapefile / SUMO net.xml 导出库。
    依赖方向：MapExport → SimCore；Editor（Godot）→ MapExport。
    本工程只做格式转换，不含 Godot 依赖。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MapExport</AssemblyName>
    <RootNamespace>SignalPlanner.MapExport</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SimCore/SimCore.csproj" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" Version="1.2.0" />
  </ItemGroup>

</Project>
